            print(num, end=" ")
        print()

def ejercicio2():
    matriz = [
         [10, 20, 30],
        [40, 50, 60],
        [70, 80, 90]]
    
    suma_total = 0
    for fila in matriz:
        for num in fila:
            suma_total += num

    print("Matriz 3x3 múltiplos de 10:")
    for fila in matriz:
        print(fila)
    print("Esta es la suamn:", suma_total)

