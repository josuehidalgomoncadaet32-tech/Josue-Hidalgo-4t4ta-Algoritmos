def ejercicio4():
    matriz = [
        [15, 22, 3, 44],
        [55, 6, 17, 8],
        [9, 100, 11, 12],
        [13, 14, 25, 16]
    ]
    mayor = matriz[0][0]

    for fila in matriz:
        for num in fila:
            if num > mayor:
                mayor = num

    print("Matriz 4x4:")
    for fila in matriz:
        print(fila)
    print("El número más mayor  es:", mayor)

